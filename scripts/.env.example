# =============================================================================
#  NIFTY Dashboard — VPS Environment Variables
#  Copy this to .env.local in the project root and fill in your values.
#  NEVER commit .env.local to git.
# =============================================================================

# ── Upstox API Credentials (from https://developer.upstox.com) ────────────────
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here

# ── Upstox Redirect URI ───────────────────────────────────────────────────────
# Must exactly match what you registered in the Upstox developer portal.
# For a VPS with domain: https://yourdomain.com/api/upstox/callback
# For local dev:          http://localhost:3000/api/upstox/callback
UPSTOX_REDIRECT_URI=http://YOUR_VPS_IP:3000/api/upstox/callback

# ── Auto-Login Credentials (used ONLY by scripts/auto-login.py) ──────────────
# Mobile number registered with Upstox (10 digits only, no +91 prefix)
UPSTOX_MOBILE=9876543210

# Your Upstox 6-digit login PIN (the one you enter after OTP on the login page)
# This is NOT the trading/order PIN — it's the login PIN set in the Upstox app
UPSTOX_PIN=123456

# TOTP Secret Key — THIS IS NOT THE 6-DIGIT CODE
# It is the base32 string shown when you set up 2FA in the Upstox app.
# How to get it:
#   1. Open Upstox app → Profile → Security → Two-Factor Auth
#   2. Choose "Setup TOTP" — it shows a QR code AND a text key below it
#   3. Copy the text key (looks like: JBSWY3DPEHPK3PXP)
#   4. Paste it here — it never changes, unlike the 6-digit code
#
# If you already have it in Google Authenticator:
#   Export accounts → scan QR → use a TOTP extractor app to get the secret
UPSTOX_TOTP_SECRET=YOUR_BASE32_TOTP_SECRET_HERE

# ── Token file location (default is fine — matches what Next.js reads) ─────────
# UPSTOX_RUNTIME_TOKEN_FILE=/opt/nifty/data/runtime/upstox-token.json

# ── Next.js ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── DeepSeek Analyst Layer ───────────────────────────────────────────────────
# Chat model for faster routine questions
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Reasoning model for deeper strategist-style analysis
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# Main API key used by /api/chat
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Optional: override API endpoints ─────────────────────────────────────────
# UPSTOX_TOKEN_ENDPOINT=https://api.upstox.com/v2/login/authorization/token
# UPSTOX_OPTION_CHAIN_ENDPOINT=https://api.upstox.com/v2/option/chain
# UPSTOX_NORMALIZE_TO_LOTS=true
# COI_RATIO_LOT_SIZE=75
# SAMPLE_FORCE_INTERVAL_MS=185000
# STRIKE_HISTORY_RETENTION_DAYS=5
